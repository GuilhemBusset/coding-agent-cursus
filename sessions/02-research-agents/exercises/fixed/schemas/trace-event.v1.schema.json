        "schema_version",
        "event_id",
        "run_id",
        "sequence",
        "elapsed_ms",
        "type",
        "request_id",
        "attempt_id",
        "retry_of",
        "status",
        "duration_ms",
        "usage",
        "error"
      ],
      "additionalProperties": false
    },
