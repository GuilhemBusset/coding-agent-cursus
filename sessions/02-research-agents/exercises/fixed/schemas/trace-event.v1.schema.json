        "retry_of": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "cancelled"
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "usage": {
          "$ref": "common.v1.schema.json#/$defs/usage"
        },
        "error": {
          "oneOf": [
            {
              "$ref": "common.v1.schema.json#/$defs/error"
