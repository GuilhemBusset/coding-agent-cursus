{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool-result.v1.schema.json",
  "title": "tool-result v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "tool_call_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "tool": {
          "const": "read"
        },
        "status": {
          "const": "ok"
        },
        "data": {
          "type": "object",
          "properties": {
            "span": {
              "$ref": "common.v1.schema.json#/$defs/span"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "span",
            "text"
          ],
          "additionalProperties": false
        },
        "error": {
          "type": "null"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "tool_call_id",
        "tool",
        "status",
        "data",
        "error"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "tool_call_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "tool": {
          "const": "search"
        },
        "status": {
          "const": "ok"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "span": {
                "$ref": "common.v1.schema.json#/$defs/span"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "span",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "error": {
          "type": "null"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "tool_call_id",
        "tool",
        "status",
        "data",
        "error"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "tool_call_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "tool": {
          "const": "check_table"
        },
        "status": {
          "const": "ok"
        },
        "data": {
          "type": "object",
          "properties": {
            "source_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "method_left": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "method_right": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "metric": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "pairs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "pair_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "left_row": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "right_row": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "left_value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "right_value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "feasible": {
                    "const": true
                  },
                  "experiment_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  }
                },
                "required": [
                  "pair_id",
                  "left_row",
                  "right_row",
                  "left_value",
                  "right_value",
                  "feasible",
                  "experiment_id"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "excluded_rows": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "left_mean": {
              "type": "number",
              "minimum": 0
            },
            "right_mean": {
              "type": "number",
              "minimum": 0
            },
            "relative_reduction": {
              "type": "number"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "common.v1.schema.json#/$defs/span"
              },
              "minItems": 1
            }
          },
          "required": [
            "source_id",
            "method_left",
            "method_right",
            "metric",
            "unit",
            "pairs",
            "excluded_rows",
            "left_mean",
            "right_mean",
            "relative_reduction",
            "evidence"
          ],
          "additionalProperties": false
        },
        "error": {
          "type": "null"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "tool_call_id",
        "tool",
        "status",
        "data",
        "error"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "tool_call_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "tool": {
          "enum": [
            "read",
            "search",
            "check_table"
          ]
        },
        "status": {
          "const": "error"
        },
        "data": {
          "type": "null"
        },
        "error": {
          "$ref": "common.v1.schema.json#/$defs/error"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "tool_call_id",
        "tool",
        "status",
        "data",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
