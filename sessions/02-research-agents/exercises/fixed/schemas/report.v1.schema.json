{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report.v1.schema.json",
  "title": "report v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "variant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "claims_path": {
      "const": "claims.json"
    },
    "report_path": {
      "const": "report.md"
    },
    "claim_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "anchor": {
            "type": "string",
            "pattern": "^claim-[A-Za-z0-9_.-]+$"
          }
        },
        "required": [
          "claim_id",
          "anchor"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "variant_id",
    "claims_path",
    "report_path",
    "claim_anchors"
  ],
  "additionalProperties": false
}
