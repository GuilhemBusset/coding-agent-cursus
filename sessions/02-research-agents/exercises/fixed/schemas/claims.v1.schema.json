{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claims.v1.schema.json",
  "title": "claims v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "variant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "kind": {
            "enum": [
              "factual",
              "decision",
              "uncertainty"
            ]
          },
          "assertion": {
            "$ref": "common.v1.schema.json#/$defs/assertion"
          },
          "support_status": {
            "enum": [
              "supported",
              "unsupported",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "common.v1.schema.json#/$defs/span"
            },
            "minItems": 0
          },
          "reference_fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "experiment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "supersedes_claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "claim_id",
          "kind",
          "assertion",
          "support_status",
          "evidence",
          "reference_fact_ids",
          "experiment_ids",
          "supersedes_claim_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "variant_id",
    "claims"
  ],
  "additionalProperties": false
}
