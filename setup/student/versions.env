# Pinned versions for the student setup (install.sh and install.ps1 next to this file).
# One KEY=value per line, no quotes, no spaces: both entry points parse it, and when the setup
# runs from its one-liner they download it from main. How to bump: README.md#bump-the-pins.

# uv, through its versioned installer https://astral.sh/uv/<UV_VERSION>/install.sh (.ps1).
UV_VERSION=0.13.7
# mise, through https://mise.run (and https://mise.run/powershell) with MISE_VERSION set.
MISE_VERSION=v2026.10.12
# gh from GitHub's release archive, used only on macOS without Homebrew, checked against these
# SHA-256 values from the release's gh_<version>_checksums.txt.
GH_VERSION=2.103.3
GH_MACOS_ARM64_SHA256=d700207eae9ae98fe2b89535c2c087c07823d4628c56364695a5a07ef311c062
GH_MACOS_AMD64_SHA256=a2f86418f4350ae6e9ec60d5000bdf7665728436946a97fc27fe50e6ae752682

# Floors: a tool at or above its floor is left alone. They must equal FLOORS in the latest
# session's exercises/check_setup.py (tests/student_setup/test_static.py checks this).
GIT_FLOOR=2.23.0
GH_FLOOR=2.0.0
UV_FLOOR=0.5.0
MISE_FLOOR=2024.1.0
