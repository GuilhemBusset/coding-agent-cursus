# Codex execution-policy rules: the declarative first line against pushing to a
# protected branch. Loaded from the trusted project layer alongside
# .codex/config.toml.
#
# Division of labor (ADR 0004): these prefix rules catch the *common spellings*
# declaratively; the PreToolUse hook (scripts/guard-main.sh) catches arbitrary
# forms a prefix match cannot express (refspecs like HEAD:main, --no-verify,
# flags between tokens); the GitHub ruleset + .githooks/* remain the guarantee.
#
# Validate offline with: codex execpolicy check .codex/rules/protected-main.rules

prefix_rule(
    pattern = ["git", "push", "origin", "main"],
    decision = "forbidden",
    justification = "main is PR-only. Push your feature branch, then run /ship (Claude Code) or $ship (Codex) to open a PR.",
)

prefix_rule(
    pattern = ["git", "push", "origin", "master"],
    decision = "forbidden",
    justification = "master is PR-only. Push your feature branch, then run /ship (Claude Code) or $ship (Codex) to open a PR.",
)
